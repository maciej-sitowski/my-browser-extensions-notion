{
  "manifest_version": 3,
  "name": "Notion Connector",
  "version": "0.3.0",
  "description": "Capture Notion tasks and journal notes from the browser.",
  "action": {
    "default_title": "Notion Connector"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://api.notion.com/*"]
}
